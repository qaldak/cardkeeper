# Copy to .env and replace the passwords. .env is git-ignored and must never be committed.
# Use URL-safe passwords (they end up in DATABASE_URL), e.g.:  openssl rand -hex 24

# PostgreSQL superuser password (only used to create the application role on first start).
POSTGRES_PASSWORD=change-me
# Password of the application's own database role.
APP_DB_PASSWORD=change-me-too

# Secret that seals the login cookies: at least 32 random characters, e.g.  openssl rand -hex 32
# The app refuses to start with a shorter value. Changing it logs everybody out.
SESSION_SECRET=change-me
# The users, separated by commas. Missing ones are created at startup with the initial password "cardkeeper" and have
# to choose their own at the first login. Removing a name here deletes nothing.
USERS=anna,max

# Optional settings with their defaults:
# APP_DB_NAME=cardkeeper
# APP_DB_USER=cardkeeper
# Port published on the host and the address it is bound to (localhost by default).
# APP_PORT=3000
# APP_BIND_ADDRESS=127.0.0.1
# Marketplace used for list prices and the total value (cardmarket, tcgplayer, ebay, amazon, coolstuffinc).
# PRICE_SOURCE=cardmarket
# Maximum size of a manually uploaded card image in MB.
# MAX_UPLOAD_MB=5
# Scheduled reload of the prices (only prices are written, the history keeps every reload). The prices of a card are due
# when they are older than PRICE_REFRESH_AFTER: a number and h (hours), d (days), w (weeks) or mo (months), e.g. 12h, 3d, 1w,
# 1mo; "off" switches the reload off. At most PRICE_REFRESH_BATCH_SIZE cards are reloaded in one tranche, and the next
# tranche starts at the earliest PRICE_REFRESH_BATCH_EVERY later (at least 1h). PRICE_REFRESH_DELAY_MS is the pause between
# two requests to a card database (at least 100; YGOPRODeck allows 20 requests per second). The tranche size does not change
# the request rate, only how long a tranche takes (about 0.5 to 1 s per Pokémon card): keep it below about 1000 Pokémon cards.
# PRICE_REFRESH_AFTER=1w
# PRICE_REFRESH_BATCH_SIZE=300
# PRICE_REFRESH_BATCH_EVERY=1d
# PRICE_REFRESH_DELAY_MS=500
# Use a specific image instead of ghcr.io/qaldak/cardkeeper:latest.
# APP_IMAGE=ghcr.io/qaldak/cardkeeper:1.2.3
# Prefix of the container names (cardkeeper_app, cardkeeper_db). Container names are unique per Docker host, so a
# second stack next to this one, e.g. the branch test in the README, needs its own prefix: CONTAINER_PREFIX=cardkeeper-test
# CONTAINER_PREFIX=cardkeeper
